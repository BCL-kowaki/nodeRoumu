generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                          String    @id @default(cuid())
  name                        String
  nameKana                    String?
  birthDate                   DateTime?
  gender                      String    @default("男")
  address                     String?
  phone                       String?
  hireDate                    DateTime
  position                    String?
  employmentType              String    @default("正社員")
  resignDate                  DateTime?
  hourlyWage                  Int?
  monthlySalary               Int?
  memo                        String?
  shiftStart                  String? // 固定シフト開始時刻 "HH:MM"
  shiftEnd                    String? // 固定シフト終了時刻 "HH:MM"
  shiftBreak                  Int? // 固定シフト休憩時間（分）
  healthInsuranceEnrolled     Boolean   @default(false) // 健康保険加入
  pensionEnrolled             Boolean   @default(false) // 厚生年金加入
  employmentInsuranceEnrolled Boolean   @default(false) // 雇用保険加入
  contractEndDate             DateTime? // 契約終了日（契約社員向け）
  loginId                     String?   @unique
  passwordHash                String?
  role                        String    @default("employee") // "admin" | "employee"
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  attendance Attendance[]
  payroll    Payroll[]
  dakoku     Dakoku[]

  // 業務管理（代表者のみ利用）
  workProjects        WorkProject[]
  workClients         WorkClient[]
  taskAttachments     TaskAttachment[]
  workTasks           WorkTask[]
  routines            Routine[]
  workPlans           WorkPlan[]
  timeEntries         TimeEntry[]
  githubRepos         GithubRepo[]
  integrationAccounts IntegrationAccount[]
}

model Attendance {
  id           String   @id @default(cuid())
  employeeId   String
  date         DateTime @db.Date
  startTime    String?
  endTime      String?
  breakMinutes Int?
  status       String? // "normal" | "late" | "early_leave" | "absent"
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model Dakoku {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  time       String
  type       String // "in" | "break_start" | "break_end" | "out"
  latitude   Float? // GPS緯度
  longitude  Float? // GPS経度
  timestamp  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model Payroll {
  id                  String   @id @default(cuid())
  employeeId          String
  month               String // "YYYY-MM"
  workDays            Int      @default(0)
  workHours           Float    @default(0)
  grossPay            Int      @default(0)
  overtimePay         Int      @default(0)
  allowance           Int      @default(0)
  totalPay            Int      @default(0)
  healthInsurance     Int      @default(0)
  pension             Int      @default(0)
  employmentInsurance Int      @default(0)
  incomeTax           Int      @default(0)
  residentTax         Int      @default(0)
  otherDeduction      Int      @default(0)
  totalDeduction      Int      @default(0)
  netPay              Int      @default(0)
  confirmed           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
}

model Rate {
  id                  String   @id @default(cuid())
  healthInsurance     Float    @default(10.34)
  pension             Float    @default(18.3)
  employmentInsurance Float    @default(0.6)
  childcare           Float    @default(0.36)
  label               String?
  closedSun           Boolean  @default(true) // 日曜定休
  closedMon           Boolean  @default(false)
  closedTue           Boolean  @default(false)
  closedWed           Boolean  @default(false)
  closedThu           Boolean  @default(false)
  closedFri           Boolean  @default(false)
  closedSat           Boolean  @default(true) // 土曜定休
  updatedAt           DateTime @updatedAt
}

model Company {
  id                 String    @id @default(cuid())
  name               String    @default("") // 会社名
  nameKana           String? // フリガナ
  representativeName String? // 代表者名
  address            String? // 所在地
  phone              String? // 電話番号
  email              String? // メールアドレス
  establishedDate    DateTime? // 設立日
  businessType       String? // 事業内容
  corporateNumber    String? // 法人番号
  memo               String? // 備考
  updatedAt          DateTime  @updatedAt
}

model ClosedDate {
  id   String   @id @default(cuid())
  date DateTime @db.Date // 休日の日付
  name String // 名称（例: "元日"）
  type String   @default("national") // "national" | "company"

  @@unique([date])
}

// FAQ書類（就業規則・社内ルールなどのPDF）
// 管理者がアップロードし、全ロールが閲覧できる
// 将来的にAIチャットボットのRAGソースとして利用予定
model FaqDocument {
  id          String   @id @default(cuid())
  title       String // 表示タイトル
  category    String? // カテゴリ（例: "就業規則"）
  description String? // 補足説明
  fileName    String // 元ファイル名
  fileSize    Int // バイトサイズ
  mimeType    String   @default("application/pdf")
  dataBase64  String   @db.Text // Base64エンコード済みファイル本体
  uploadedBy  String // 作成者のEmployee.id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// ===== 業務管理（代表者のみ利用） =====
// どのデータも ownerId（Employee.id）で持ち主を持ち、検索・更新は必ず ownerId で絞る。
// 持ち主の従業員レコードを誤って削除して業務データが消えないよう onDelete: Restrict にしている。

// 業務管理のクライアント（取引先）。プロジェクトは必ずどこかのクライアントに所属する
model WorkClient {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    Employee      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  projects WorkProject[]
  routines Routine[]

  @@unique([ownerId, name])
}

model WorkProject {
  id               String    @id @default(cuid())
  ownerId          String
  clientId         String
  name             String
  description      String?   @db.Text
  status           String    @default("active") // "active" | "on_hold" | "done" | "archived"
  color            String? // "#rrggbb"
  startDate        DateTime? @db.Date
  dueDate          DateTime? @db.Date
  sortOrder        Int       @default(0)
  // Obsidian ノート連携（ノート用リポジトリ内の相対パス。未紐づけは NULL）
  obsidianPath     String?
  obsidianSyncedAt DateTime? // 最後にアプリからノートを読み書きした日時
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner       Employee     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // プロジェクトが残っているクライアントは削除できない
  client      WorkClient   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tasks       WorkTask[]
  routines    Routine[]
  plans       WorkPlan[]
  entries     TimeEntry[]
  githubRepos GithubRepo[]

  @@index([ownerId, status])
  @@index([clientId])
}

// タスクの添付資料。ファイル本体は代表者の Google ドライブにあり、ここには一覧表示用の情報だけを持つ
model TaskAttachment {
  id          String   @id @default(cuid())
  ownerId     String
  taskId      String
  driveFileId String
  name        String
  mimeType    String
  size        Int
  webViewLink String   @db.Text
  createdAt   DateTime @default(now())

  owner Employee @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // タスクを削除したら一覧からも消す（ドライブのファイルは残る）
  task  WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([ownerId, driveFileId])
  @@index([taskId])
}

model WorkTask {
  id                String    @id @default(cuid())
  ownerId           String
  projectId         String?
  title             String
  description       String?   @db.Text
  status            String    @default("todo") // "todo" | "doing" | "done" | "canceled"
  priority          Int       @default(2) // 1=高 2=中 3=低
  dueDate           DateTime? @db.Date
  plannedMinutes    Int?
  completedAt       DateTime?
  sortOrder         Int       @default(0)
  // GitHub Issue 連携（手入力のタスクはすべて NULL）
  githubRepoId      String?
  githubIssueNumber Int?
  githubState       String? // "open" | "closed"
  githubUpdatedAt   DateTime? // GitHub 側の updated_at（取り込み済みかの判定に使う）
  githubHtmlUrl     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner       Employee         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // プロジェクトを削除してもタスクは残し、プロジェクト未設定に戻す
  project     WorkProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  githubRepo  GithubRepo?      @relation(fields: [githubRepoId], references: [id], onDelete: SetNull)
  plans       WorkPlan[]
  entries     TimeEntry[]
  attachments TaskAttachment[]

  // 同じ Issue を二重に取り込まない（手入力のタスクは列が NULL なので重複扱いにならない）
  @@unique([ownerId, githubRepoId, githubIssueNumber])
  @@index([ownerId, status, dueDate])
  @@index([projectId])
}

// ルーティン（繰り返し業務）。実施日は保存せず src/lib/work/recurrence.ts で毎回計算する
model Routine {
  id             String    @id @default(cuid())
  ownerId        String
  projectId      String?
  // クライアント（任意）。プロジェクトがあるときは、そのプロジェクトのクライアントにそろえる
  clientId       String?
  title          String
  description    String?   @db.Text
  frequency      String // "daily" | "weekly" | "monthly"
  weekdays       Int       @default(0) // 毎週: 曜日のビット（日=1, 月=2, 火=4, 水=8, 木=16, 金=32, 土=64）
  monthDay       Int? // 毎月: 1〜31、-1 は月末
  skipClosedDays Boolean   @default(false) // 休日（定休・会社休日）は実施日にしない
  plannedMinutes Int?
  active         Boolean   @default(true)
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner   Employee       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project WorkProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  WorkClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  checks  RoutineCheck[]
  entries TimeEntry[]
  plans   WorkPlan[]

  @@index([ownerId, active])
  @@index([projectId])
  @@index([clientId])
}

// ルーティンの実施記録。チェックした日だけ行を作る（ルーティンを削除すると記録も消える）
model RoutineCheck {
  id        String   @id @default(cuid())
  routineId String
  date      DateTime @db.Date
  status    String   @default("done") // "done" | "skipped"
  note      String?
  checkedAt DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([date])
}

// 業務計画（ある日の予定ブロック）
model WorkPlan {
  id             String    @id @default(cuid())
  ownerId        String
  date           DateTime  @db.Date // 日本時間の日付
  startTime      String? // "HH:MM"（任意）
  plannedMinutes Int
  title          String
  taskId         String?
  projectId      String?
  routineId      String? // ルーティンから置いた計画
  // Google カレンダーの予定から取り込んだ計画（元の予定のID）。書き出しの対象にはしない
  sourceEventId  String?
  sortOrder      Int       @default(0)
  // Google カレンダーへの書き出し（未書き出しは NULL）
  googleEventId  String?
  googleSyncedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner   Employee     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  task    WorkTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project WorkProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  routine Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  entries TimeEntry[]

  // 同じ日に同じ予定を二重に取り込まない（手で作った計画は NULL なので対象外）
  @@unique([ownerId, date, sourceEventId])
  @@index([ownerId, date])
  @@index([routineId])
}

// 実績（タイマーまたは手入力）。計測中のタイマーは endedAt が null で、常に1件まで
model TimeEntry {
  id        String    @id @default(cuid())
  ownerId   String
  date      DateTime  @db.Date // 日本時間での開始日（出勤簿の date と同じ基準）
  startedAt DateTime? // タイマーのとき必須
  endedAt   DateTime? // タイマー計測中は null
  minutes   Int? // 停止時に計算、または手入力
  source    String    @default("manual") // "timer" | "manual"
  note      String?
  taskId    String?
  projectId String?
  routineId String?
  planId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner   Employee     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  task    WorkTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project WorkProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  routine Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  plan    WorkPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([ownerId, date])
  @@index([ownerId, endedAt])
}

// GitHub のリポジトリ（アクセストークンで見えるもの）。syncIssues が true のものだけ Issue をタスクに同期する
model GithubRepo {
  id              String    @id @default(cuid())
  ownerId         String
  githubId        String // GitHub 側の repo id（桁が大きくなりうるため文字列で持つ）
  fullName        String // "owner/name"
  description     String?
  isPrivate       Boolean
  isArchived      Boolean   @default(false)
  htmlUrl         String
  defaultBranch   String
  openIssuesCount Int       @default(0) // プルリクエストを含まない件数（同期時に更新）
  openPrCount     Int       @default(0)
  pushedAt        DateTime?
  syncIssues      Boolean   @default(false)
  // 紐づけたプロジェクト。取り込んだ Issue のタスクは、このプロジェクトに入る
  projectId       String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner   Employee     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project WorkProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   WorkTask[]

  @@unique([ownerId, githubId])
  @@index([projectId])
}

// 外部サービス（Google カレンダー）との接続情報。トークンは必ず暗号化して保存する（src/lib/crypto.ts）
model IntegrationAccount {
  id                    String    @id @default(cuid())
  ownerId               String
  provider              String // "google"
  accountEmail          String? // 接続した Google アカウント（表示用）
  encryptedRefreshToken String    @db.Text // "v1:iv:tag:暗号文"
  accessTokenExpiresAt  DateTime?
  scopes                String?
  calendarId            String? // 書き出し先の専用カレンダー「業務計画」（未作成は NULL）
  driveFolderId         String? // 添付資料を入れる Google ドライブのフォルダ（未作成は NULL）
  status                String    @default("active") // "active" | "needs_reconnect"
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner Employee @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, provider])
}
